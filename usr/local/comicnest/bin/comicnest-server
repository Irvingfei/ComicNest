#!/usr/bin/env python3
"""ComicNest for TOS - backend entry point."""

import argparse
import os
import sys

APP_ROOT = os.environ.get("COMICNEST_ROOT") or os.path.dirname(
    os.path.dirname(os.path.abspath(__file__))
)
LIB_DIR = os.path.join(APP_ROOT, "lib")
if APP_ROOT not in sys.path:
    sys.path.insert(0, APP_ROOT)
if LIB_DIR not in sys.path:
    sys.path.append(LIB_DIR)

os.environ.setdefault("COMICNEST_ROOT", APP_ROOT)


def main(argv=None):
    from lib import __version__

    parser = argparse.ArgumentParser(
        prog="comicnest-server", description="ComicNest for TOS"
    )
    parser.add_argument("--version", action="version", version="comicnest %s" % __version__)
    parser.add_argument("--check", action="store_true", help="validate the runtime and exit")
    parser.add_argument("--socket", metavar="PATH", help="override the Unix socket path")
    parser.add_argument("--dev", action="store_true", help="run an unauthenticated TCP server")
    parser.add_argument("--port", type=int, default=8787, help="TCP port used with --dev")
    args = parser.parse_args(argv)

    if args.socket:
        os.environ["COMICNEST_SOCKET"] = args.socket
    if args.dev:
        os.environ["COMICNEST_REQUIRE_AUTH"] = "false"
        os.environ["COMICNEST_REQUIRE_SYSTEM_USER"] = "false"
        os.environ["COMICNEST_DEV_TCP"] = str(args.port)
        os.environ.setdefault("COMICNEST_LOG_LEVEL", "INFO")

    from lib.server import check_environment, serve_forever

    if args.check:
        return check_environment()
    try:
        serve_forever()
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())

# Environment for ComicNest for TOS
# Loaded by systemd through EnvironmentFile=/usr/local/comicnest/comicnest.env

# Application identity (used by forward/reverse proxy path normalisation)
COMICNEST_APP_ID=comicnest
# It is recommended to align this value with config.ini "path"
COMICNEST_PROXY_PREFIX=/comicnest/

# Unix socket that the built-in HTTP server binds to
COMICNEST_SOCKET=/var/api/comicnest.sock

# Runtime data. The index is derived from the files; deleting it costs one
# rescan. The cache holds remote archives downloaded on demand and is trimmed
# to COMICNEST_CACHE_GB automatically.
COMICNEST_DATA_DIR=/usr/local/comicnest/data
COMICNEST_LOG_DIR=/usr/local/comicnest/logs
COMICNEST_CACHE_GB=8
COMICNEST_TMP_DIR=/usr/local/comicnest/data/tmp

# The shared folder this application creates for its own library. Folders an
# operator links from the admin page are read in place and never copied.
COMICNEST_SHARE_NAME=comicnest
COMICNEST_LIBRARY_DIR=library

# Scan and index. The filesystem remains the source of truth.
COMICNEST_SCAN_ON_START=true
COMICNEST_SCAN_WORKERS=1

# Bundled 7-Zip for RAR/7z archives (the build installs the binary here).
COMICNEST_SEVEN_ZIP=/usr/local/comicnest/vendor/7zip/7zz

# Authentication. TOS forwards the platform session; the user name arrives in
# the platform cookie. Members of an administrator group may manage sources.
COMICNEST_REQUIRE_AUTH=true
COMICNEST_REQUIRE_SYSTEM_USER=true
COMICNEST_USER_COOKIE=tos_current_username
COMICNEST_ADMIN_GROUPS=administrators,admin,wheel

# Log levels: DEBUG | INFO | WARN | ERROR (keep INFO or higher in production)
COMICNEST_LOG_LEVEL=INFO
COMICNEST_LOG_TO_FILE=false

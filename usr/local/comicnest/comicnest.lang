[zh-cn]
name = "ComicNest"
auth = "TerraMaster 社区开发者"
descript = "在 NAS 上直接阅读漫画：支持 CBZ、CBR、CB7、ZIP、RAR、TAR、PDF 与图片文件夹；单页、双页、拆分双页；从右到左、从左到右与连续竖读；缩放、亮度、翻页动画与进度记忆。漫画库可指向共享文件夹，也可挂载 WebDAV、SMB 服务器按需读取，无需先下载。"
release_note = "1. 首个版本。2. 自动扫描共享文件夹并识别标题、章节与封面。3. 支持 CBZ、CBR、CB7、ZIP、RAR、TAR、PDF 与图片文件夹。4. 单页、双页、拆分双页与连续竖读。5. 从右到左、从左到右阅读方向。6. 平移、卷轴与仿真翻页动画。7. 缩放、亮度与阅读进度记忆。8. 搜索与继续阅读。9. 挂载 WebDAV、SMB 远程漫画库并按需缓存。10. 深色模式与九种界面语言。"
important = "漫画从共享文件夹或远程来源读取。应用安装时创建共享文件夹 comicnest 作为默认漫画库；若要添加已有文件夹，请为 comicnest 账户授予读取权限。卸载应用不会删除漫画或 comicnest 共享文件夹。"

[zh-hk]

[en-us]
name = "ComicNest"
auth = "TerraMaster Community Developer"
descript = "Read comics and manga straight from the NAS: CBZ, CBR, CB7, ZIP, RAR, TAR, PDF and image folders; single, double and split pages; right-to-left, left-to-right and continuous vertical reading; zoom, brightness, page-turn animations and remembered progress. Libraries can be shared folders or WebDAV/SMB servers read on demand."
release_note = "1. First release. 2. Automatic scan of shared folders with title, chapter and cover detection. 3. CBZ, CBR, CB7, ZIP, RAR, TAR, PDF and image folders. 4. Single, double, split-page and continuous vertical reading. 5. Right-to-left and left-to-right directions. 6. Slide, scroll and page-flip animations. 7. Zoom, brightness and remembered progress. 8. Search and continue reading. 9. WebDAV and SMB libraries with an on-demand cache. 10. Dark mode and nine interface languages."
important = "Comics are read from shared folders or added remote sources. The application creates the shared folder comicnest for its own library; adding an existing folder needs read access for the comicnest account. Uninstalling never deletes comics or the comicnest share."

[fr-fr]
name = "ComicNest"
auth = "Développeur communautaire TerraMaster"
descript = "Lisez vos BD et mangas directement depuis le NAS : CBZ, CBR, CB7, ZIP, RAR, TAR, PDF et dossiers d'images ; pages simples, doubles ou divisées ; lecture de droite à gauche, de gauche à droite ou verticale continue ; zoom, luminosité, animations de page et reprise de la lecture. Les bibliothèques peuvent être des dossiers partagés ou des serveurs WebDAV/SMB lus à la demande."
release_note = "1. Première version. 2. Analyse automatique des dossiers partagés avec détection des titres, chapitres et couvertures. 3. CBZ, CBR, CB7, ZIP, RAR, TAR, PDF et dossiers d'images. 4. Pages simples, doubles, divisées et lecture verticale continue. 5. Sens de lecture de droite à gauche ou de gauche à droite. 6. Animations par glissement, défilement et effet de page. 7. Zoom, luminosité et reprise de la lecture. 8. Recherche et lecture en cours. 9. Bibliothèques WebDAV et SMB avec cache à la demande. 10. Thème sombre et neuf langues d'interface."
important = "Les BD sont lues dans des dossiers partagés ou des sources distantes. L'application crée le dossier partagé comicnest pour sa bibliothèque ; ajouter un dossier existant demande un accès en lecture au compte comicnest. La désinstallation ne supprime jamais les BD ni le partage comicnest."

[de-de]
